# ---------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ---------------------------------------------
# Local Docker DB:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/watercan?schema=public"
# Production Azure DB (Replace with your Azure PostgreSQL Flexible Server URL):
# DATABASE_URL="postgresql://<admin>:<password>@<server>.postgres.database.azure.com:5432/watercan?schema=public"

# ---------------------------------------------
# 2. CACHE & BACKGROUND JOBS (Redis)
# ---------------------------------------------
# Local Docker Redis:
REDIS_HOST="localhost"
REDIS_PORT=6379
# Production Azure Cache for Redis (Replace with your Azure Redis URL):
# REDIS_URL="redis://:<password>@<name>.redis.cache.windows.net:6380"

# ---------------------------------------------
# 3. AUTHENTICATION (NestJS JWT)
# ---------------------------------------------
# Generate strong random strings for these!
JWT_SECRET="super-secret-jwt-key-replace-me-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-key-replace-me"

# ---------------------------------------------
# 4. RAZORPAY INTEGRATION (Payments)
# ---------------------------------------------
# Get these from your Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_HERE"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_SECRET_HERE"
# This webhook secret must match the one you configure in the Razorpay dashboard!
RAZORPAY_WEBHOOK_SECRET="my_secure_webhook_secret_123"

# ---------------------------------------------
# 5. FRONTEND CONFIGURATIONS (Next.js)
# ---------------------------------------------
# The URL where your NestJS API is running (used by the Next.js apps)
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_HERE"
